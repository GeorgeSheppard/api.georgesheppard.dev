NODE_ENV=test
PORT=3001

# Database - Will be set by test setup.ts with PostgreSQL container URL
DATABASE_USER=test_user
DATABASE_PASSWORD=test_password
DATABASE_PORT=5432
DATABASE_HOST=localhost
DATABASE_DB=test_db
DATABASE_MIGRATIONS_PATH=./src/core/database/migrations

# RabbitMQ - Will be set by test setup.ts with RabbitMQ container URL
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# API Keys (dummy values for testing)
API_KEY=test-api-key-123456789
MAILGUN_API_KEY=test-mailgun-key
OPENAI_API_KEY=test-openai-key
TFL_API_KEY=test-tfl-key

# JWT (dummy value for testing)
JWT_SECRET=test-secret-key-that-is-at-least-32-characters-long

# Cognito (dummy values for testing)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_123456789
COGNITO_CLIENT_ID=test-client-id-123456
COGNITO_CLIENT_SECRET=test-client-secret-123456
COGNITO_DOMAIN=https://test-domain.auth.us-east-1.amazoncognito.com

# Auth session / OAuth (dummy values for testing)
SESSION_SECRET=test-session-secret-that-is-at-least-32-characters-long
BACKEND_URL=http://localhost:3001

# Encryption (exact lengths required: 32 bytes for key, 16 bytes for IV)
ENCRYPTION_KEY=12345678901234567890123456789012
ENCRYPTION_IV=1234567890123456

# DynamoDB - Will be set by test fixture with LocalStack container URL
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_NAME=lifesitetable
DYNAMODB_ACCESS_KEY_ID=test
DYNAMODB_SECRET_ACCESS_KEY=test

S3_BUCKET_NAME=test
S3_ACCESS_KEY_ID=test-access-key
S3_SECRET_ACCESS_KEY=test-secret-access-key
