NODE_ENV=test
PORT=3001

# Database - Will be set by test setup.ts with PostgreSQL container URL
DATABASE_USER=test_user
DATABASE_PASSWORD=test_password
DATABASE_PORT=5432
DATABASE_HOST=localhost
DATABASE_DB=test_db
DATABASE_MIGRATIONS_PATH=./src/core/database/migrations

# RabbitMQ - Will be set by test setup.ts with RabbitMQ container URL
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# API Keys (dummy values for testing)
API_KEY=test-api-key-123456789
MAILGUN_API_KEY=test-mailgun-key
OPENAI_API_KEY=test-openai-key
TEXT_EXTRACTOR_URL=http://localhost:3002/extract

# Encryption (exact lengths required: 32 bytes for key, 16 bytes for IV)
ENCRYPTION_KEY=12345678901234567890123456789012
ENCRYPTION_IV=1234567890123456
