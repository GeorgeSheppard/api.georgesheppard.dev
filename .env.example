# Server
NODE_ENV=development
PORT=5240

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shelfie

# RabbitMQ
RABBITMQ_URL=amqp://shelfie:Shelfie1234!@localhost:5672

# API Keys
API_KEY=your-api-key-here
MAILGUN_API_KEY=your-mailgun-api-key
OPENAI_API_KEY=your-openai-api-key
TEXT_EXTRACTOR_URL=https://text-extractor.example.com

# Encryption (32 bytes for key, 16 bytes for IV)
ENCRYPTION_KEY=hFGXUZFNTTyEPy7Zgy2Y8ZKy4JA7MVXu
ENCRYPTION_IV=B5mk4uNiUd9YS3DH

# AWS Services (KitchenCalm)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
DYNAMODB_TABLE_NAME=MyLife
S3_BUCKET_NAME=your-s3-bucket-name
COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
COGNITO_REGION=eu-west-2
