# Server
NODE_ENV=development
PORT=5240

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shelfie

# RabbitMQ
RABBITMQ_URL=amqp://shelfie:Shelfie1234!@localhost:5672

# DynamoDB (KitchenCalm/MyLife)
DYNAMODB_REGION=eu-west-2
DYNAMODB_TABLE_NAME=lifesitetable
DYNAMODB_ACCESS_KEY_ID=your-dynamodb-access-key-id
DYNAMODB_SECRET_ACCESS_KEY=your-dynamodb-secret-access-key
# DYNAMODB_ENDPOINT=http://localhost:8000  # Uncomment for local testing

# S3 (KitchenCalm image storage)
S3_REGION=eu-west-2
S3_BUCKET_NAME=your-s3-bucket-name
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_ENDPOINT=http://localhost:9000  # Uncomment for local testing (e.g., MinIO)

# API Keys
API_KEY=your-api-key-here
MAILGUN_API_KEY=your-mailgun-api-key
OPENAI_API_KEY=your-openai-api-key
TEXT_EXTRACTOR_URL=https://text-extractor.example.com

# JWT
JWT_SECRET=your-secret-key-at-least-32-characters-long-for-signing-jwts

# Encryption (32 bytes for key, 16 bytes for IV)
ENCRYPTION_KEY=hFGXUZFNTTyEPy7Zgy2Y8ZKy4JA7MVXu
ENCRYPTION_IV=B5mk4uNiUd9YS3DH
